# Environment template with multiple AI provider variables

PORT=3000
NODE_ENV=development
JWT_SECRET=dev-secret
API_KEY=dev-api-key

# Local self-hosted LLM / Ollama
FREELLM_API_URL=http://localhost:11434
FREELLM_DEFAULT_MODEL=llama2

# OpenAI
OPENAI_API_KEY=

# Anthropic / Claude
CLAUDE_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Groq
GROQ_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Cohere
COHERE_API_KEY=

# Hugging Face
HUGGINGFACE_API_KEY=

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database
DB_PATH=./data/app.db
