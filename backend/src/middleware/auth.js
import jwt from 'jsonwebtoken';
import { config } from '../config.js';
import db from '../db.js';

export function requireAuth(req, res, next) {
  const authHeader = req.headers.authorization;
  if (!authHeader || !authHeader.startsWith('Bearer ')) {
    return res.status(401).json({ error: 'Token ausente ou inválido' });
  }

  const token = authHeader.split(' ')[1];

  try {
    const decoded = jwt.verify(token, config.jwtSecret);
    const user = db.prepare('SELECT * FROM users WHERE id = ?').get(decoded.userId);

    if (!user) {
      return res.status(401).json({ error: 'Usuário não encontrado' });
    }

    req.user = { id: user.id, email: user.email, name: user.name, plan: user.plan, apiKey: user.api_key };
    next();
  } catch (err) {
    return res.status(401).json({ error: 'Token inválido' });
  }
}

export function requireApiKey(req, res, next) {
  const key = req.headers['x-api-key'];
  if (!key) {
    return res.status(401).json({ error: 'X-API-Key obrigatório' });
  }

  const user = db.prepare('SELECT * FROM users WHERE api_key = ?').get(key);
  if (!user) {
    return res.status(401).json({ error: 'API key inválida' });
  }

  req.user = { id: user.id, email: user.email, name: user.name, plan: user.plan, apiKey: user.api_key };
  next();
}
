import axios from 'axios';
import { config } from './config.js';

export const llmClient = axios.create({
  baseURL: config.freellmApiUrl,
  timeout: 30000
});

export async function getAvailableModels() {
  try {
    const response = await llmClient.get('/models');
    if (Array.isArray(response.data)) return response.data;
    if (response.data?.models) return response.data.models;
    return [
      { name: 'llama3', description: 'Llama 3' },
      { name: 'mistral', description: 'Mistral' },
      { name: 'gpt-oss', description: 'GPT OSS' }
    ];
  } catch {
    return [
      { name: 'llama3', description: 'Llama 3' },
      { name: 'mistral', description: 'Mistral' },
      { name: 'gpt-oss', description: 'GPT OSS' }
    ];
  }
}

export async function sendToLLM({ message, model, messages = [] }) {
  const payloadMessages = messages.length
    ? messages.map((msg) => ({ role: msg.role, content: msg.content }))
    : [{ role: 'user', content: message }];

  const response = await llmClient.post('/chat', {
    model: model || config.freellmDefaultModel,
    messages: payloadMessages,
    temperature: 0.7,
    top_p: 0.9
  });

  return response.data;
}
